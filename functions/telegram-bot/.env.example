# Скопируйте этот файл в .env.local и заполните значения:
#   cp .env.example .env.local

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here

# Локально: http://host.docker.internal:54321
# Продакшен: https://<project-ref>.supabase.co
SB_URL=https://<project-ref>.supabase.co
SB_SERVICE_ROLE_KEY=your_service_role_key_here

BOT_MESSAGES_TABLE=messages
BOT_SESSIONS_TABLE=telegram_bot_sessions
BOT_TZ_OFFSET_MINUTES=180
BOT_DEFAULT_TYPE=text
